---
import Icon from "./Icon.astro";

interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, accent, description, align = "left" } = Astro.props;
---

<div class:list={["section-heading", align === "center" && "section-heading--center"]}>
  <p class="eyebrow"><span class="eyebrow-mark"></span>{eyebrow}</p>
  <h2>{title}{accent && <> <span class="text-gradient">{accent}</span></>}</h2>
  {description && <p class="section-description">{description}</p>}
  {align === "center" && <Icon name="spark" size={15} class="heading-spark" />}
</div>
