---
import Icon from "../components/Icon.astro";
import PageCTA from "../components/PageCTA.astro";
import PageFrame from "../components/PageFrame.astro";
---

<PageFrame
  title="Contact"
  description="Contact HighEnd IT Sales & Solutions to discuss AI, cloud, software and technology services."
  eyebrow="Contact"
  heading="Tell us what you’re working toward."
  lead="Share a little context and send an enquiry to HighEnd IT Sales & Solutions. Online submissions remain disabled until data-handling approval is complete."
  breadcrumbs={[{ label: "Contact" }]}
  kind="contact-page"
>
  <section class="contact-layout page-section">
    <form class="request-form" data-request-form data-endpoint="/api/enquiries" data-request-type="Enquiry">
      <input name="industry" type="hidden" data-industry-interest />
      <div class="form-heading"><Icon name="message" size={21} /><div><h2>Send an enquiry</h2><p>Share only the information needed to understand your request.</p></div></div>
      <div class="form-grid">
        <label>Your name<input name="name" type="text" autocomplete="name" maxlength="120" required /><span data-field-errors aria-live="polite"></span></label>
        <label>Work email<input name="email" type="email" autocomplete="email" maxlength="254" required /><span data-field-errors aria-live="polite"></span></label>
        <label class="form-field-wide">Organization <span class="optional-label">Optional</span><input name="organization" type="text" autocomplete="organization" maxlength="160" /><span data-field-errors aria-live="polite"></span></label>
        <label class="form-field-wide">What would you like to discuss?<textarea name="message" rows="5" maxlength="4000" required></textarea><span data-field-errors aria-live="polite"></span></label>
        <label class="form-consent form-field-wide"><input name="consent" type="checkbox" value="I understand this information is submitted to HighEnd IT Sales &amp; Solutions." required /><span>I understand this information will be submitted to HighEnd IT Sales &amp; Solutions if the service is enabled.</span><span data-field-errors aria-live="polite"></span></label>
        <label class="form-honeypot" aria-hidden="true">Leave this field empty<input name="companyWebsite" tabindex="-1" autocomplete="off" /></label>
      </div>
      <button class="button button-primary" type="submit">Submit enquiry <Icon name="arrow" size={16} /></button>
      <p class="request-status" data-request-status role="status" aria-live="polite"></p>
      <p class="form-footnote">The server will not store personal data until data-residency and handling approvals are complete. Do not include sensitive information.</p>
    </form>
    <aside class="contact-aside">
      <p class="eyebrow"><span class="eyebrow-mark"></span> Based in Abu Dhabi</p>
      <h2>HighEnd IT<br /><span class="text-gradient">Sales &amp; Solutions LLC</span></h2>
      <p>Abu Dhabi, United Arab Emirates</p>
      <div class="contact-aside-line"><Icon name="globe" size={18} /><span>Technology solutions for organizations across industries.</span></div>
      <div class="contact-aside-line"><Icon name="shield" size={18} /><span>Please do not include passwords, payment information or sensitive personal data.</span></div>
      <a class="text-link" href="/consultation/">Prepare a consultation request <Icon name="arrow" size={15} /></a>
    </aside>
  </section>
  <PageCTA title="Still exploring? Start with the services." description="Review the capabilities, then return when you have a challenge or idea to discuss." />
  <script>
    import { attachRequestForms } from "../scripts/request-form";
    attachRequestForms();
  </script>
</PageFrame>
