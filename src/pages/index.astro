---
import Icon from "../components/Icon.astro";
import IndustryCard from "../components/IndustryCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { industries } from "../data/industries";
import { services } from "../data/services";

const featuredServices = ["ai-solutions", "cloud-devops", "software-development", "cybersecurity", "technology-products"]
  .map((slug) => services.find((service) => service.slug === slug))
  .filter((service) => service !== undefined);
---

<SiteLayout
  title="HighEnd IT Sales & Solutions | Intelligence for What's Next"
  description="Practical AI, cloud, automation, software and technology solutions from HighEnd IT Sales & Solutions LLC, Abu Dhabi, UAE."
>
  <SiteHeader />
  <main id="main">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-grid"></div>
      <div class="hero-copy" data-reveal>
        <p class="eyebrow hero-eyebrow"><span class="status-pulse"></span> Abu Dhabi · Built for what’s next</p>
        <h1 id="hero-title">Intelligence<br />{" "}for <span class="text-gradient">What’s Next.</span></h1>
        <p class="hero-lede">AI. Cloud. Automation. Solutions.</p>
        <p class="hero-description">
          We turn emerging technology into practical solutions—helping businesses work smarter today and prepare with confidence for what comes next.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/services/ai-solutions/">Explore AI solutions <Icon name="arrow" size={17} /></a>
          <a class="button button-quiet" href="#intelligence"><span class="button-play"><Icon name="arrow" size={13} /></span> Preview HighEnd Intelligence</a>
        </div>
        <div class="hero-note">
          <span class="note-line"></span>
          <span>Practical innovation. Human-led by design.</span>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="visual-orbit visual-orbit--outer"></div>
        <div class="visual-orbit visual-orbit--middle"></div>
        <div class="visual-orbit visual-orbit--inner"></div>
        <div class="visual-crosshair visual-crosshair--one"></div>
        <div class="visual-crosshair visual-crosshair--two"></div>
        <div class="visual-globe">
          <div class="globe-latitude globe-latitude--one"></div>
          <div class="globe-latitude globe-latitude--two"></div>
          <div class="globe-longitude"></div>
          <div class="globe-core"></div>
          <div class="globe-shine"></div>
        </div>
        <div class="orbit-node orbit-node--top"><Icon name="brain" size={16} /><span>Applied AI</span></div>
        <div class="orbit-node orbit-node--right"><Icon name="network" size={16} /><span>Connected systems</span></div>
        <div class="orbit-node orbit-node--bottom"><Icon name="spark" size={16} /><span>Human potential</span></div>
        <span class="visual-coordinate coordinate-one">24.4539° N<br />54.3773° E</span>
        <span class="visual-coordinate coordinate-two">HIGHEND IT / INTELLIGENCE<br />FIELD 001</span>
        <div class="visual-caption"><span class="caption-dot"></span> A more connected world</div>
      </div>

      <div class="hero-bottom">
        <span class="hero-bottom-label">One partner for the next step</span>
        <div class="hero-capabilities">
          <span>Artificial intelligence</span><i></i><span>Cloud &amp; DevOps</span><i></i><span>Software</span><i></i><span>Technology</span>
        </div>
        <a href="/services/" class="text-link">Discover our capabilities <Icon name="arrow" size={15} /></a>
      </div>
      <div class="hero-index" aria-hidden="true">01 <span>/</span> 06</div>
    </section>

    <section class="services-section section-shell" id="services">
      <div class="section-topline" data-reveal>
        <SectionHeading
          eyebrow="What we do"
          title="Technology that"
          accent="moves you forward."
          description="From the first question to the working solution, we bring the right capabilities together around your goals."
        />
        <a class="text-link section-link" href="/services/">Explore our services <Icon name="arrow" size={15} /></a>
      </div>
      <div class="service-grid">
        {featuredServices.map((service, index) => <ServiceCard service={service} featured={index === 0} />)}
      </div>
      <div class="service-footnote"><span class="footnote-star">✳</span> The right-sized solution starts with understanding your world.</div>
    </section>

    <section class="future-section section-shell" id="future">
      <div class="future-visual" data-reveal aria-hidden="true">
        <div class="future-grid"></div>
        <div class="future-ring future-ring--one"></div>
        <div class="future-ring future-ring--two"></div>
        <div class="future-ring future-ring--three"></div>
        <div class="future-center"><Icon name="atom" size={37} /><span>INTELLIGENCE<br />{" "}IN PROGRESS</span></div>
        <span class="future-node future-node--a">AI</span>
        <span class="future-node future-node--b">H</span>
        <span class="future-node future-node--c">↗</span>
        <span class="future-coordinate future-coordinate--a">NOW / APPLY</span>
        <span class="future-coordinate future-coordinate--b">NEXT / EXPLORE</span>
      </div>
      <div class="future-copy" data-reveal>
        <p class="eyebrow"><span class="eyebrow-mark"></span> Innovation, grounded</p>
        <h2>Build for today.<br />{" "}<span class="text-gradient">Stay ready for tomorrow.</span></h2>
        <p class="future-intro">The future of intelligence is still unfolding. We focus on the useful work happening now—while thoughtfully exploring what may be possible next.</p>
        <div class="future-principles">
          <div><span class="principle-index">A</span><div><h3>Make AI useful</h3><p>Apply today’s AI to real needs, with clear purpose and people in control.</p></div></div>
          <div><span class="principle-index">B</span><div><h3>Design for change</h3><p>Build adaptable foundations that can evolve as technology and your business do.</p></div></div>
          <div><span class="principle-index">C</span><div><h3>Explore responsibly</h3><p>Stay curious about advanced and AGI-era developments without overstating what exists today.</p></div></div>
        </div>
        <a class="text-link" href="/services/ai-readiness/">Our AI readiness approach <Icon name="arrow" size={15} /></a>
      </div>
    </section>

    <section class="industries-section section-shell" id="industries">
      <div class="industry-heading" data-reveal>
        <SectionHeading
          eyebrow="Across industries"
          title="Your world. Our"
          accent="starting point."
          description="Technology works best when it understands the context. We shape solutions around the realities of each industry."
        />
        <span class="industry-side-note"><Icon name="globe" size={19} /> Global perspective<br />{" "}Abu Dhabi roots</span>
      </div>
      <div class="industry-list" data-reveal>
        {industries.slice(0, 7).map((industry) => <IndustryCard industry={industry} />)}
        <a class="industry-item industry-item--more" href="/industries/">
          <span class="industry-item-icon"><Icon name="spark" size={19} /></span>
          <span>Explore all industries</span>
          <span class="industry-arrow"><Icon name="arrow" size={15} /></span>
        </a>
      </div>
      <div class="industry-footer" data-reveal>
        <span>Every challenge is different. The conversation starts with yours.</span>
        <a href="/industries/" class="text-link">Explore the industry guide <Icon name="arrow" size={15} /></a>
      </div>
    </section>

    <section class="intelligence-section section-shell" id="intelligence">
      <div class="intelligence-copy" data-reveal>
        <p class="eyebrow"><span class="status-pulse"></span> HighEnd Intelligence · AI assistant</p>
        <h2>Curious about<br />{" "}what AI can do <span class="text-gradient">for you?</span></h2>
        <p>Ask about our published services and industry capabilities. Get a grounded starting point, explore relevant services and prepare for a human conversation.</p>
        <div class="assistant-assurance"><Icon name="shield" size={17} /><span>Designed for useful answers, human judgment and responsible use.</span></div>
      </div>
      <div class="chat-card" data-reveal>
        <div class="chat-header">
          <div class="chat-avatar"><img src="/highend-it-sales-solution-logo.png" alt="" width="38" height="38" /></div>
          <div><strong>HighEnd Intelligence</strong><span><i class="chat-online"></i><span data-assistant-status>Checking assistant configuration…</span></span></div>
          <button class="chat-reset" type="button" aria-label="Reset conversation">↺</button>
        </div>
        <div class="chat-body" id="chat-messages" aria-live="polite" aria-relevant="additions" aria-busy="false">
          <div class="chat-message chat-message--assistant">
            <span class="chat-message-label">HIGHEND INTELLIGENCE</span>
            <p>Hello. I can answer questions about our published services and industry capabilities. What are you looking to improve?</p>
          </div>
        </div>
        <div class="suggestion-row" aria-label="Suggested questions">
          <button class="suggestion-chip" type="button" data-prompt="Where can AI help my business?">Where can AI help?</button>
          <button class="suggestion-chip" type="button" data-prompt="How do I get started with automation?">Getting started</button>
        </div>
        <form class="chat-form" id="chat-form">
          <label class="sr-only" for="chat-input">Ask HighEnd Intelligence a question</label>
          <input id="chat-input" name="prompt" maxlength="1200" placeholder="Ask a question…" autocomplete="off" required />
          <button class="chat-send" type="submit" aria-label="Send question"><Icon name="arrowUp" size={17} /></button>
        </form>
        <p class="chat-disclaimer">AI-generated starting points can be incorrect. Avoid personal, sensitive or confidential information. <a href="/consultation/">Talk to our team</a>.</p>
      </div>
      <div class="intelligence-orbit intelligence-orbit--one"></div>
      <div class="intelligence-orbit intelligence-orbit--two"></div>
    </section>

    <section class="trust-section section-shell" id="about">
      <div class="trust-heading" data-reveal>
        <SectionHeading
          eyebrow="Built on trust"
          title="Technology should"
          accent="earn your confidence."
          description="Innovation matters. So do security, transparency and the people affected by every decision."
        />
      </div>
      <div class="trust-grid">
        <article class="trust-item" data-reveal>
          <span class="trust-icon"><Icon name="lock" size={20} /></span>
          <h3>Security in the design</h3>
          <p>We consider security and privacy as part of the solution—not something to bolt on later.</p>
        </article>
        <article class="trust-item" data-reveal style="--reveal-delay:90ms">
          <span class="trust-icon"><Icon name="brain" size={20} /></span>
          <h3>People stay in control</h3>
          <p>AI can assist and augment. Human judgment remains essential, especially when the stakes are high.</p>
        </article>
        <article class="trust-item" data-reveal style="--reveal-delay:180ms">
          <span class="trust-icon"><Icon name="spark" size={20} /></span>
          <h3>Clear about the possible</h3>
          <p>We focus on practical capability today and speak honestly about what is still emerging.</p>
        </article>
      </div>
      <div class="trust-statement" data-reveal>
        <span class="statement-mark">“</span>
        <p>Real progress isn’t about chasing the future.<br />{" "}<span>It’s about making the next step matter.</span></p>
        <span class="statement-end">HIGHEND / PRINCIPLE 01</span>
      </div>
    </section>

    <section class="contact-section section-shell" id="contact">
      <div class="contact-frame" data-reveal>
        <div class="contact-grid"></div>
        <div class="contact-orb" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="contact-content">
          <p class="eyebrow"><span class="eyebrow-mark"></span> The next step starts here</p>
          <h2>Let’s make<br />{" "}<span class="text-gradient">something meaningful.</span></h2>
          <p>Tell us what you’re working toward. We’ll help you explore where technology can take you.</p>
          <a class="button button-primary" href="/consultation/">Request a consultation <Icon name="arrow" size={17} /></a>
          <span class="contact-footnote">A thoughtful conversation. No assumptions.</span>
        </div>
        <div class="contact-side-label">HIGHEND IT SALES &amp; SOLUTIONS <span>·</span> ABU DHABI, UAE</div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries, currentObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            currentObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealItems.forEach((item) => observer.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    }

    import { attachIntelligenceChat } from "../scripts/intelligence-chat";
    attachIntelligenceChat();
  </script>
</SiteLayout>
